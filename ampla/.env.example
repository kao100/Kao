# ---------------------------------------------------------------------------
# Ampla Dados — configuração
# Copie para .env e ajuste. Nenhum segredo entra no repositório.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Postgres e Redis (o docker-compose já sobe ambos com estes valores)
DATABASE_URL=postgres://ampla:ampla@localhost:5432/ampla_dados
REDIS_URL=redis://localhost:6379

# Segredo de sessão do painel. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-isto-por-uma-chave-aleatoria-de-64-hex

# --- Fontes públicas gratuitas -------------------------------------------
# Portal da Transparência (PEP, CEIS, CNEP, CEPIM). Chave gratuita em:
# https://api.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# DataJud/CNJ. A chave pública é divulgada pelo próprio CNJ na documentação:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# --- Fontes pagas (desligadas por padrão) ---------------------------------
# Ligue apenas quando houver contrato. Enquanto ENABLED=false o conector
# responde "fonte_indisponivel" e não gera custo nem chamada externa.
SERPRO_CPF_ENABLED=false
SERPRO_CPF_BASE_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v1
SERPRO_CPF_TOKEN=

BUREAU_ENABLED=false
BUREAU_BASE_URL=
BUREAU_TOKEN=
