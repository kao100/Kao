{
  "name": "ampla-dados",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma interna de consulta de dados da Ampla",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "ingest:cnpj": "node --experimental-strip-types ingest/receita-cnpj.ts",
    "ingest:pgfn": "node --experimental-strip-types ingest/pgfn-devedores.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "node --experimental-strip-types ingest/seed-demo.ts",
    "criar-admin": "node --experimental-strip-types ingest/criar-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
